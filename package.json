{
  "name": "catalystread",
  "version": "1.0.0",
  "description": "CatalystRead — a personal technology publication. Catalyzing ideas into understanding.",
  "scripts": {
    "ng": "ng",
    "generate": "node scripts/generate-content.mjs",
    "validate": "node scripts/validate-content.mjs",
    "watch:content": "node --watch-path=src/content scripts/generate-content.mjs",
    "prestart": "npm run generate",
    "start": "ng serve",
    "prebuild": "npm run generate",
    "build": "ng build",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.17.19",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "jsdom": "^28.0.0",
    "marked": "^18.0.11",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
